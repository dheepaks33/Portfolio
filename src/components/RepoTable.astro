---
import type { Project } from '../lib/live';
import { formatDate, freshness } from '../lib/format';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const showStars = projects.some((p) => (p.repo?.stars ?? 0) > 0);
---

<div class="repo-table" data-reveal>
  <table>
    <caption class="sr-only">All other public repositories, most recently updated first</caption>
    <thead>
      <tr>
        <th scope="col">Repository</th>
        <th scope="col">What it is</th>
        <th scope="col">Language</th>
        <th scope="col">Last push</th>
        {showStars && <th scope="col" class="num">Stars</th>}
      </tr>
    </thead>
    <tbody>
      {
        projects.map((p) => (
          <tr>
            <th scope="row">
              <a href={p.url} rel="noopener">
                {p.title}
              </a>
            </th>
            <td class="what">{p.tagline}</td>
            <td class="lang mono">{p.repo?.language ?? '—'}</td>
            <td class="when mono">
              {p.repo ? <time datetime={p.repo.pushedAt} title={formatDate(p.repo.pushedAt)}>{freshness(p.repo.pushedAt)}</time> : '—'}
            </td>
            {showStars && <td class="num mono">{p.repo?.stars ?? 0}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .repo-table {
    margin-top: clamp(40px, 6vw, 64px);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
  }

  thead th {
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    color: var(--muted);
  }

  tbody th,
  tbody td {
    padding: 13px 16px 13px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
  }

  tbody th {
    font-weight: 500;
    white-space: nowrap;
  }

  .what {
    color: var(--ink-2);
  }

  .lang,
  .when,
  .num {
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .num {
    text-align: right;
  }

  @media (max-width: 719px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
    }

    tbody th,
    tbody td {
      padding: 0;
      border: 0;
    }

    tbody th {
      white-space: normal;
    }

    .what {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .lang {
      grid-column: 1;
      grid-row: 3;
    }

    .when {
      grid-column: 2;
      grid-row: 1;
    }

    .num {
      display: none;
    }
  }
</style>
