---
import { sections } from '../data/sections';
---

<nav class="rail" aria-label="Sections">
  <p class="rail-title eyebrow" aria-hidden="true">Memory map</p>
  <ol>
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-rail-link={s.id}>
            <span class="addr">{s.addr}</span>
            <span class="label">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="pc" aria-hidden="true" title="Your position on the page, as a program counter">
    <span class="pc-label">PC</span>
    <span class="pc-value" data-pc>0x0000</span>
  </p>
  <p class="hint" aria-hidden="true">
    <span><kbd>0</kbd>–<kbd>7</kbd> jump</span>
    <span><kbd data-cmdk-key>Ctrl K</kbd> menu</span>
  </p>
</nav>

<style>
  .rail {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }

  .rail-title {
    margin-bottom: 14px;
    font-size: 0.68rem;
  }

  ol {
    list-style: none;
    border-left: 1px solid var(--rule);
  }

  a {
    display: flex;
    gap: 12px;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  a:hover {
    color: var(--ink);
  }

  a[aria-current='true'] {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  a[aria-current='true'] .addr {
    color: var(--accent);
  }

  .addr {
    font-variant-numeric: tabular-nums;
  }

  .pc {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .pc-label {
    padding: 0 5px;
    border-radius: 3px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  .pc-value {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .hint {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .hint kbd {
    font-size: 0.64rem;
  }

  :global(html:not(.js)) .pc,
  :global(html:not(.js)) .hint {
    display: none;
  }
</style>
