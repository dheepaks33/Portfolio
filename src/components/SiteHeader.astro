---
import { profile } from '../data/profile';
---

<header class="site-header">
  <div class="inner">
    <a class="monogram" href="#intro" aria-label={`${profile.name}, back to top`}>
      <span class="ds">ds</span><span class="dot" aria-hidden="true"></span>
    </a>

    <nav class="quick" aria-label="Quick links">
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="actions">
      <button
        class="cmdk"
        type="button"
        data-palette-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
        aria-label="Open command menu"
        title="Command menu"
      >
        <svg class="cmdk-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M5 7l5 5-5 5M12 17h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="cmdk-text" aria-hidden="true">Commands</span>
        <kbd class="cmdk-kbd" aria-hidden="true" data-cmdk-key>Ctrl K</kbd>
      </button>
      <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>

<script>
  import { toggleTheme } from '../scripts/theme';

  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const r = button.getBoundingClientRect();
    toggleTheme({ x: r.left + r.width / 2, y: r.top + r.height / 2 });
  });

  // Show the shortcut for this platform.
  const platform =
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform;
  if (/mac|iphone|ipad/i.test(platform)) {
    document.querySelectorAll('[data-cmdk-key]').forEach((key) => (key.textContent = '⌘K'));
  }

  // Hairline under the header once the page has scrolled.
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--rule);
  }

  /* Reading progress along the bottom edge (driven by src/scripts/interactions.ts) */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1240px;
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .monogram {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .monogram .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .quick {
    display: none;
    gap: 22px;
    margin-left: auto;
    font-size: 0.9rem;
  }

  .quick a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .quick a:hover {
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .cmdk,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    min-width: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .cmdk:hover,
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--rule);
  }

  .cmdk-text,
  .cmdk-kbd {
    display: none;
  }

  :global(html:not(.js)) .cmdk {
    display: none;
  }

  .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }

  @media (min-width: 720px) {
    .quick {
      display: flex;
    }

    .actions {
      margin-left: 12px;
    }

    .cmdk {
      padding: 0 8px 0 12px;
      border: 1px solid var(--rule-strong);
    }

    .cmdk-icon {
      display: none;
    }

    .cmdk-text,
    .cmdk-kbd {
      display: inline;
    }
  }
</style>
