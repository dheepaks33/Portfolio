---
// ⌘K / Ctrl+K command menu: jump to sections and projects, copy the email,
// switch theme, start the signal-chain demo, or open profiles.
import { sections } from '../data/sections';
import { profile } from '../data/profile';
import { featuredProjects } from '../lib/live';

type Action =
  | { type: 'scroll'; target: string }
  | { type: 'link'; href: string }
  | { type: 'copy'; text: string; label: string }
  | { type: 'theme' }
  | { type: 'event'; name: string };

interface Command {
  label: string;
  hint: string;
  group: string;
  keywords?: string;
  action: Action;
}

const commands: Command[] = [
  ...sections.map(
    (s): Command => ({ label: s.label, hint: s.addr, group: 'Go to', keywords: `${s.id} section`, action: { type: 'scroll', target: s.id } }),
  ),
  {
    label: 'Play the signal-chain demo',
    hint: '▶',
    group: 'Do',
    keywords: 'audio sound dsp eq lab bench music',
    action: { type: 'event', name: 'dsp-lab:play' },
  },
  {
    label: 'Copy email address',
    hint: 'copy',
    group: 'Do',
    keywords: `mail contact ${profile.email}`,
    action: { type: 'copy', text: profile.email, label: 'email address' },
  },
  { label: 'Write an email', hint: '↗', group: 'Do', keywords: 'mail contact', action: { type: 'link', href: `mailto:${profile.email}` } },
  { label: 'Switch colour theme', hint: 'theme', group: 'Do', keywords: 'dark light mode color', action: { type: 'theme' } },
  ...featuredProjects.map(
    (p): Command => ({
      label: p.title,
      hint: 'project',
      group: 'Projects',
      keywords: (p.curated?.stack ?? []).join(' '),
      action: { type: 'scroll', target: `p-${p.name}` },
    }),
  ),
  { label: 'GitHub', hint: '↗', group: 'Elsewhere', keywords: 'code repositories', action: { type: 'link', href: profile.links.github } },
  { label: 'LinkedIn', hint: '↗', group: 'Elsewhere', action: { type: 'link', href: profile.links.linkedin } },
  { label: 'LeetCode', hint: '↗', group: 'Elsewhere', action: { type: 'link', href: profile.links.leetcode } },
  { label: 'CodeChef', hint: '↗', group: 'Elsewhere', action: { type: 'link', href: profile.links.codechef } },
];

const json = JSON.stringify(commands).replace(/</g, '\\u003c');
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="search">
    <span class="prompt" aria-hidden="true">›</span>
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Type a command or search"
      placeholder="Jump to a section, copy email, play the demo…"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd>esc</kbd>
  </div>
  <ul id="palette-list" class="list" role="listbox" aria-label="Commands" data-palette-list></ul>
  <p class="foot" aria-hidden="true">
    <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> run</span>
    <span><kbd>0</kbd>–<kbd>7</kbd> jump to a section</span>
  </p>
  <script type="application/json" data-palette-commands set:html={json} />
</dialog>

<script>
  import { jumpTo, isTyping } from '../scripts/nav';
  import { copyText } from '../scripts/toast';
  import { toggleTheme } from '../scripts/theme';

  type Action =
    | { type: 'scroll'; target: string }
    | { type: 'link'; href: string }
    | { type: 'copy'; text: string; label: string }
    | { type: 'theme' }
    | { type: 'event'; name: string };

  interface Command {
    label: string;
    hint: string;
    group: string;
    keywords?: string;
    action: Action;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');

  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-palette-list]')!;
    const commands: Command[] = JSON.parse(dialog.querySelector('[data-palette-commands]')?.textContent || '[]');
    let results = commands;
    let active = 0;

    const options = () => [...list.querySelectorAll<HTMLElement>('[role="option"]')];

    const render = () => {
      const query = input.value.trim().toLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      results = commands.filter((c) => {
        const hay = `${c.label} ${c.group} ${c.hint} ${c.keywords ?? ''}`.toLowerCase();
        return terms.every((t) => hay.includes(t));
      });
      active = Math.min(active, Math.max(0, results.length - 1));

      const items: HTMLElement[] = [];
      let group = '';
      results.forEach((c, i) => {
        if (!query && c.group !== group) {
          group = c.group;
          const heading = document.createElement('li');
          heading.className = 'group';
          heading.setAttribute('role', 'presentation');
          heading.textContent = group;
          items.push(heading);
        }
        const li = document.createElement('li');
        li.id = `cmd-${i}`;
        li.className = 'option';
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === active));
        li.dataset.index = String(i);
        const label = document.createElement('span');
        label.className = 'label';
        label.textContent = c.label;
        const hint = document.createElement('span');
        hint.className = 'hint';
        hint.textContent = c.hint;
        li.append(label, hint);
        items.push(li);
      });
      if (!results.length) {
        const empty = document.createElement('li');
        empty.className = 'empty';
        empty.setAttribute('role', 'presentation');
        empty.textContent = 'No matching commands';
        items.push(empty);
      }
      list.replaceChildren(...items);
      if (results.length) input.setAttribute('aria-activedescendant', `cmd-${active}`);
      else input.removeAttribute('aria-activedescendant');
    };

    const setActive = (i: number, scroll = true) => {
      if (!results.length) return;
      active = (i + results.length) % results.length;
      for (const el of options()) el.setAttribute('aria-selected', String(Number(el.dataset.index) === active));
      input.setAttribute('aria-activedescendant', `cmd-${active}`);
      if (scroll) list.querySelector(`#cmd-${active}`)?.scrollIntoView({ block: 'nearest' });
    };

    const run = (c: Command) => {
      dialog.close();
      const a = c.action;
      switch (a.type) {
        case 'scroll':
          jumpTo(a.target);
          break;
        case 'link':
          if (a.href.startsWith('mailto:')) window.location.href = a.href;
          else window.open(a.href, '_blank', 'noopener');
          break;
        case 'copy':
          copyText(a.text, a.label);
          break;
        case 'theme':
          toggleTheme();
          break;
        case 'event':
          window.dispatchEvent(new CustomEvent(a.name));
          break;
      }
    };

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      active = 0;
      render();
      dialog.showModal();
      input.focus();
    };

    input.addEventListener('input', () => {
      active = 0;
      render();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') setActive(active + 1);
      else if (e.key === 'ArrowUp') setActive(active - 1);
      else if (e.key === 'Home' && results.length) setActive(0);
      else if (e.key === 'End' && results.length) setActive(results.length - 1);
      else if (e.key === 'Enter' && results[active]) run(results[active]);
      else return;
      e.preventDefault();
    });

    list.addEventListener('pointermove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (li && Number(li.dataset.index) !== active) setActive(Number(li.dataset.index), false);
    });

    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (li) run(results[Number(li.dataset.index)]);
    });

    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      } else if (e.key === '/' && !dialog.open && !isTyping(e.target)) {
        e.preventDefault();
        open();
      }
    });

    document.querySelectorAll('[data-palette-open]').forEach((el) => el.addEventListener('click', open));
  }
</script>

<style>
  .palette {
    width: min(560px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
    flex-direction: column;
  }

  .palette::backdrop {
    background: rgba(12, 12, 14, 0.42);
    backdrop-filter: blur(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: palette-in 0.18s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--rule);
  }

  .prompt {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--accent);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
  }

  .search input:focus {
    outline: none;
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .list {
    flex: 1;
    overflow-y: auto;
    padding: 6px;
    list-style: none;
  }

  .list :global(.group) {
    padding: 10px 10px 4px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .list :global(.option) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 10px;
    border-radius: 6px;
    cursor: pointer;
  }

  .list :global(.option[aria-selected='true']) {
    background: var(--accent-wash);
  }

  .list :global(.option[aria-selected='true'] .label) {
    color: var(--ink);
  }

  .list :global(.label) {
    color: var(--ink-2);
  }

  .list :global(.hint) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .list :global(.option[aria-selected='true'] .hint) {
    color: var(--accent);
  }

  .list :global(.empty) {
    padding: 18px 10px;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 10px 16px;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
