---
// The nBase2 audio system as a signal chain. Blocks carry data-chain-block ids
// that match the `chain` tags on experience bullets; hovering either lights both.

const facts = [
  { value: '3', label: 'DSP audio algorithms in C', detail: 'Equalizer · stereo widening · anti-aliasing' },
  { value: '4', label: 'Host and audio interfaces', detail: 'I2C · I2S · luna-send · Windows drivers' },
  { value: '2', label: 'DSP families', detail: 'Cadence HiFi · TI audio DSPs' },
  { value: '2 yrs', label: 'Shipping production software', detail: 'Embedded, tooling and product' },
];
---

<figure class="chain" data-reveal>
  <ol class="flow" aria-label="Audio signal chain I worked on at nBase2 Systems">
    <li class="block" data-chain-block="tool" tabindex="0">
      <span class="stage">Host</span>
      <span class="name">Tuning app</span>
      <span class="detail">Angular · TypeScript · in-system tuning for TI DSPs</span>
    </li>

    <li class="link" data-chain-block="link" tabindex="0">
      <span class="bus">I2C<br />luna-send<br />Windows drivers</span>
      <span class="line" aria-hidden="true"></span>
    </li>

    <li class="block" data-chain-block="config" tabindex="0">
      <span class="stage">Control</span>
      <span class="name">Sequencing</span>
      <span class="detail">I2C command sequences · binary config files</span>
    </li>

    <li class="link link--short" aria-hidden="true">
      <span class="line"></span>
    </li>

    <li class="block block--dsp" data-chain-block="dsp" tabindex="0">
      <span class="stage">DSP · real-time C</span>
      <span class="algos">
        <span>EQ</span><span class="arrow" aria-hidden="true">→</span><span>Stereo widening</span><span
          class="arrow"
          aria-hidden="true">→</span
        ><span>Anti-aliasing</span>
      </span>
      <span class="detail">Cadence HiFi instruction set · TI audio DSPs</span>
    </li>

    <li class="link" data-chain-block="out" tabindex="0">
      <span class="bus">I2S</span>
      <span class="line" aria-hidden="true"></span>
    </li>

    <li class="block" data-chain-block="out" tabindex="0">
      <span class="stage">Out</span>
      <span class="name">Audio devices</span>
      <span class="detail">Host and consumer hardware</span>
    </li>
  </ol>

  <figcaption class="caption">
    <span class="mono">nBase2 Systems · 2024–2026</span>
    Hover or focus a block to light up the work behind it in Experience.
  </figcaption>
</figure>

<dl class="facts" data-reveal>
  {
    facts.map((f) => (
      <div class="fact">
        <dt>{f.label}</dt>
        <dd class="value">{f.value}</dd>
        <dd class="detail">{f.detail}</dd>
      </div>
    ))
  }
</dl>

<style>
  .chain {
    margin: 0;
  }

  .flow {
    display: grid;
    grid-template-columns: 1fr;
    list-style: none;
  }

  /* Blocks */
  .block {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 16px 18px 18px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    cursor: default;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .block--dsp {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent-wash) 55%, var(--bg-raised));
  }

  .block:hover,
  .block:focus-visible,
  .block.is-lit {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    outline: none;
  }

  .stage {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .block--dsp .stage {
    color: var(--accent);
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.05;
  }

  .algos {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .algos .arrow {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .detail {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Links between blocks: vertical on small screens */
  .link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 64px;
    padding-left: 28px;
    outline: none;
  }

  .link--short {
    min-height: 28px;
  }

  .link .line {
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 6px;
    width: 1.5px;
    background: repeating-linear-gradient(180deg, var(--accent) 0 5px, transparent 5px 10px);
    background-size: 100% 10px;
  }

  .link .line::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    border: 4.5px solid transparent;
    border-top: 6px solid var(--accent);
    border-bottom: 0;
  }

  .bus {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--ink-2);
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .link:hover .bus,
  .link:focus-visible .bus,
  .link.is-lit .bus {
    background: var(--accent-wash);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .link .line {
      animation: flow-down 0.9s linear infinite;
    }
  }

  @keyframes flow-down {
    to {
      background-position: 0 10px;
    }
  }

  @keyframes flow-right {
    to {
      background-position: 10px 0;
    }
  }

  /* Horizontal chain on wide screens */
  @media (min-width: 980px) {
    .flow {
      grid-template-columns: 1fr 96px 1fr 28px 1.5fr 64px 0.9fr;
      align-items: stretch;
    }

    .link {
      display: block;
      min-height: 0;
      padding: 0;
      text-align: center;
    }

    /* Wire sits on the blocks' vertical centre; its label rides just above. */
    .link .line {
      left: 6px;
      right: 8px;
      top: 50%;
      bottom: auto;
      width: auto;
      height: 1.5px;
      background: repeating-linear-gradient(90deg, var(--accent) 0 5px, transparent 5px 10px);
      background-size: 10px 100%;
    }

    .link .line::after {
      left: auto;
      right: -7px;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
      border: 4.5px solid transparent;
      border-left: 7px solid var(--accent);
      border-right: 0;
    }

    .bus {
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(50% + 8px);
      font-size: 0.68rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      .link .line {
        animation-name: flow-right;
      }
    }
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 18px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .caption .mono {
    color: var(--ink-2);
  }

  /* Facts strip */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(40px, 6vw, 64px) 0 0;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 18px 22px 0;
    background: var(--bg);
  }

  .fact:nth-child(even) {
    padding-left: 18px;
  }

  .fact dt {
    order: 2;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .fact .value {
    order: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .fact .detail {
    order: 3;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (min-width: 860px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .fact,
    .fact:nth-child(even) {
      padding-left: 18px;
    }

    .fact:first-child {
      padding-left: 0;
    }
  }
</style>
